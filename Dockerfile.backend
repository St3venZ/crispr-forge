FROM python:3.12-slim

WORKDIR /app

# Install minimal build tools for primer3-py C extensions if wheel unavailable
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml /app/pyproject.toml
COPY backend/crispr_forge /app/crispr_forge
COPY backend/data/presets /app/data/presets
COPY backend/scripts /app/scripts

RUN pip install --no-cache-dir -e .

ENV HOST=0.0.0.0
ENV PORT=8000
EXPOSE 8000

CMD ["sh", "-c", "uvicorn crispr_forge.api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
