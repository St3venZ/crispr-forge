# ==============================================================================
# CRISPR-Forge Configuration
# ==============================================================================
# 1) Optional Admin API Key for Visitor Free Trial Pool (DeepSeek is very low cost)
#    Leave empty to run 100% free with the built-in Deterministic Zero-Trust Engine
#    (visitors can still plug in their own API Key via the UI BYOK modal).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 2) Free AI Trial Quota per Visitor IP per Day (only applies when using Admin Key)
FREE_TRIAL_DAILY_LIMIT=10

# 3) NCBI Entrez Contact Email (recommended for live RefSeq genome lookups)
NCBI_EMAIL=crispr-forge@example.com
NCBI_API_KEY=

# 4) Backend Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
